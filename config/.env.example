# Free Asset Pipeline - Environment Variables
# Copy this file to .env and fill in your API keys

# ===========================
# Asset Provider API Keys
# ===========================

# Pexels API Key
# Get your key at: https://www.pexels.com/api/
# Free tier: 200 requests/hour, 20,000/month
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay API Key
# Get your key at: https://pixabay.com/api/docs/
# Free tier: 5,000 requests/hour
PIXABAY_API_KEY=your_pixabay_api_key_here

# Unsplash Access Key
# Get your key at: https://unsplash.com/developers
# Free tier: 50 requests/hour (demo)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Freesound API Key
# Get your key at: https://freesound.org/apiv2/apply/
# Free for non-commercial use
FREESOUND_API_KEY=your_freesound_api_key_here

# Giphy API Key
# Get your key at: https://developers.giphy.com/
# Free tier: 100 requests/hour (beta), upgrade available
GIPHY_API_KEY=your_giphy_api_key_here

# ===========================
# Database (Supabase)
# ===========================

# Supabase Project URL
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (keep this secret!)
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Anon Key (public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ===========================
# AI Services
# ===========================

# OpenAI API Key (for LLM-based analysis and embeddings)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Project (for Vertex AI)
# Optional - only needed for Vertex AI integration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ===========================
# Application Configuration
# ===========================

# Node Environment
NODE_ENV=development

# Next.js Port
PORT=3000

# MCP Server Port
MCP_SERVER_PORT=8080

# Redis Connection (optional)
REDIS_URL=redis://localhost:6379

# ===========================
# Optional: Rate Limiting
# ===========================

# Upstash Redis for rate limiting (optional)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ===========================
# Optional: Monitoring & Analytics
# ===========================

# Sentry DSN (for error tracking)
SENTRY_DSN=your_sentry_dsn

# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id

# ===========================
# Development Settings
# ===========================

# Enable debug logging
DEBUG=false

# Cache TTL in hours
CACHE_TTL_HOURS=24

# Maximum cache size in MB
MAX_CACHE_SIZE_MB=1000

# ===========================
# Security
# ===========================

# JWT Secret (for API authentication)
JWT_SECRET=your_random_jwt_secret_here

# API Rate Limit (requests per hour)
API_RATE_LIMIT=100

# ===========================
# Notes
# ===========================

# 1. Never commit this file with real API keys to version control
# 2. Always use environment-specific .env files (.env.local, .env.production)
# 3. Keep SUPABASE_SERVICE_ROLE_KEY and JWT_SECRET secure
# 4. For production, use Vercel/platform environment variables instead of .env files
# 5. Rotate API keys regularly for security
